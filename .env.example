# ==============================================================================
# HTS-KGA — Ortam Değişkenleri
# T-E01-10 / E-08
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# .env git'e eklenmez (.gitignore'da). Bu örnek dosya eklenir.
# ==============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hts_kga
POSTGRES_USER=hts_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ─── Gizlilik / HMAC (E-08, ADR-15) ──────────────────────────────────────────
# Üretim ortamında güçlü, rastgele bir değer kullanın.
# Örnek: openssl rand -hex 32
HMAC_SALT=CHANGE_ME_64_HEX_CHARS_MINIMUM

# ─── OTel / Gözlemlenebilirlik ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hts-kga

# ─── Geliştirici kolaylık ─────────────────────────────────────────────────────
LOG_LEVEL=info   # debug | info | warn | error
