# ==============================================================================
# HTS-KGA — Ortam Değişkenleri
# T-E01-10 / E-08
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# .env git'e eklenmez (.gitignore'da). Bu örnek dosya eklenir.
# ==============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hts_kga
POSTGRES_USER=hts_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ─── Gizlilik / HMAC (E-08, ADR-15) ──────────────────────────────────────────
# Üretim ortamında güçlü, rastgele bir değer kullanın.
# Örnek: openssl rand -hex 32
HMAC_SALT=CHANGE_ME_64_HEX_CHARS_MINIMUM

# ─── OTel / Gözlemlenebilirlik ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hts-kga

# ─── Geliştirici kolaylık ─────────────────────────────────────────────────────
LOG_LEVEL=info   # debug | info | warn | error

# ── Kafka SASL/SCRAM kimlikleri (ADR-32, kör test katman 1) ──────────────────
# Servisler 9092 (SASL_PLAINTEXT) portuna kendi principal'i ile baglanir.
# Yonetim (make seed-kafka) yayinlanmayan 9094 portunu kullanir.
#
# KAFKA_SASL_USER / KAFKA_SASL_PASSWORD her servis icin AYRI ayarlanir —
# kosum betikleri bunu yapar. Asagidakiler kurulum betiginin yazacagi
# parolalardir.
KAFKA_PW_SIMULATOR=simulator_dev_pw
KAFKA_PW_RECORDS=records_dev_pw
KAFKA_PW_GT=gtpersister_dev_pw
KAFKA_PW_ANALYSIS=analysis_dev_pw
KAFKA_PW_INTEGRITY=integrity_dev_pw
KAFKA_PW_TEST=test_dev_pw
